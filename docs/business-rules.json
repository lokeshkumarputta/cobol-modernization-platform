{
  "program": "CUSTUPD",
  "sourceFile": "legacy/cobol/CUSTOMER_UPDATE.cbl",
  "copybook": "legacy/copybook/CUSTOMER_RECORD.cpy",
  "rules": [
    { "ruleId": "BR001", "paragraph": "2100-VALIDATE-TXN", "errorCode": "E001", "condition": "TXN-CUST-ID NOT NUMERIC OR TXN-CUST-ID = 0", "action": "Reject transaction: customer id must be numeric and > 0", "javaImplementation": "CustomerController @Positive path variable / CustomerTransactionParser", "source": "COBOL" },
    { "ruleId": "BR002", "paragraph": "2100-VALIDATE-TXN", "errorCode": "E002", "condition": "TXN-CODE NOT IN ('U','S','L')", "action": "Reject transaction: invalid transaction code", "javaImplementation": "TransactionCode.fromCode", "source": "COBOL" },
    { "ruleId": "BR003", "paragraph": "2200-FETCH-CUSTOMER", "errorCode": "E003", "condition": "SELECT CUSTOMER_MASTER returns SQLCODE = 100", "action": "Reject transaction: customer not found (HTTP 404)", "javaImplementation": "CustomerUpdateService.loadCustomer -> CustomerNotFoundException", "source": "COBOL" },
    { "ruleId": "BR004", "paragraph": "2200-FETCH-CUSTOMER / 2400-UPDATE-CUSTOMER", "errorCode": "E004", "condition": "TXN-EXPECTED-VERSION != CUST-VERSION OR UPDATE ... WHERE VERSION = :v returns SQLCODE = 100", "action": "Reject transaction: record changed by another user (HTTP 409)", "javaImplementation": "Customer.verifyVersion + JPA @Version -> ConcurrentUpdateException", "source": "COBOL" },
    { "ruleId": "BR005", "paragraph": "2300-APPLY-BUSINESS-RULES", "errorCode": "E005", "condition": "CUST-STATUS = 'C' (CLOSED)", "action": "Reject any update", "javaImplementation": "Customer.ensureNotClosed", "source": "COBOL" },
    { "ruleId": "BR006", "paragraph": "2310-CONTACT-RULES", "errorCode": "E006", "condition": "TXN-CODE = 'U' AND CUST-STATUS = 'S' (SUSPENDED)", "action": "Reject contact/address update; only status changes allowed", "javaImplementation": "Customer.updateContact", "source": "COBOL" },
    { "ruleId": "BR007", "paragraph": "2310-CONTACT-RULES", "errorCode": "E007", "condition": "TXN-EMAIL supplied AND count of '@' != 1", "action": "Reject transaction: invalid email", "javaImplementation": "CustomerRules.validateEmail", "source": "COBOL" },
    { "ruleId": "BR008", "paragraph": "2310-CONTACT-RULES", "errorCode": "E008", "condition": "TXN-PHONE supplied AND TRIM(TXN-PHONE) NOT NUMERIC", "action": "Reject transaction: invalid phone", "javaImplementation": "CustomerRules.validatePhone", "source": "COBOL" },
    { "ruleId": "BR009", "paragraph": "2310-CONTACT-RULES", "errorCode": null, "condition": "TXN field is non-blank", "action": "Overwrite only supplied fields; first/last name UPPER-CASE, email LOWER-CASE", "javaImplementation": "Customer.updateContact", "source": "COBOL" },
    { "ruleId": "BR010", "paragraph": "2310-CONTACT-RULES", "errorCode": null, "condition": "Address supplied AND TXN-COUNTRY = SPACES", "action": "Default country to 'USA'", "javaImplementation": "Address.withDefaultCountry", "source": "COBOL" },
    { "ruleId": "BR011", "paragraph": "2320-STATUS-RULES", "errorCode": "E011", "condition": "TXN-NEW-STATUS NOT IN ('A','I','S','C')", "action": "Reject transaction: invalid status code", "javaImplementation": "CustomerStatus.fromCode", "source": "COBOL" },
    { "ruleId": "BR012", "paragraph": "2320-STATUS-RULES", "errorCode": "E012", "condition": "TXN-NEW-STATUS = 'C' AND CUST-ACCOUNT-BAL != 0", "action": "Reject: cannot close customer with outstanding balance", "javaImplementation": "Customer.changeStatus", "source": "COBOL" },
    { "ruleId": "BR013", "paragraph": "2320-STATUS-RULES", "errorCode": "E013", "condition": "TXN-NEW-STATUS = 'A' AND CUST-ACCOUNT-BAL < 0", "action": "Reject: cannot activate customer with negative balance", "javaImplementation": "Customer.changeStatus", "source": "COBOL" },
    { "ruleId": "BR014", "paragraph": "2330-LIMIT-RULES", "errorCode": "E014", "condition": "TXN-CODE = 'L' AND CUST-STATUS != 'A'", "action": "Reject: credit limit change requires ACTIVE customer", "javaImplementation": "Customer.changeCreditLimit", "source": "COBOL" },
    { "ruleId": "BR015", "paragraph": "2330-LIMIT-RULES", "errorCode": "E015", "condition": "TXN-NEW-LIMIT > 1000000.00", "action": "Reject: credit limit exceeds maximum", "javaImplementation": "Customer.changeCreditLimit (CustomerRules.MAX_CREDIT_LIMIT)", "source": "COBOL" },
    { "ruleId": "BR016", "paragraph": "2330-LIMIT-RULES", "errorCode": "E016", "condition": "CUST-ACCOUNT-BAL > 0 AND TXN-NEW-LIMIT < CUST-ACCOUNT-BAL", "action": "Reject: credit limit below current balance", "javaImplementation": "Customer.changeCreditLimit", "source": "COBOL" },
    { "ruleId": "BR017", "paragraph": "2330-LIMIT-RULES", "errorCode": "E017", "condition": "TXN-NEW-LIMIT > CUST-CREDIT-LIMIT AND CUST-ACCOUNT-BAL < 0", "action": "Reject: account with negative balance cannot get a limit increase", "javaImplementation": "Customer.changeCreditLimit", "source": "COBOL" },
    { "ruleId": "BR018", "paragraph": "2330-LIMIT-RULES", "errorCode": "E018", "condition": "TXN-NEW-LIMIT > CUST-CREDIT-LIMIT AND CUST-RISK-SCORE > 700", "action": "Reject: risk score too high for limit increase", "javaImplementation": "Customer.changeCreditLimit (CustomerRules.MAX_RISK_SCORE_FOR_INCREASE)", "source": "COBOL" },
    { "ruleId": "BR019", "paragraph": "2400-UPDATE-CUSTOMER", "errorCode": null, "condition": "Update succeeds", "action": "Set LAST_UPD_TS = CURRENT TIMESTAMP, LAST_UPD_USER = TXN-USER-ID, VERSION = VERSION + 1", "javaImplementation": "Customer.stampAudit + JPA @Version", "source": "COBOL" },
    { "ruleId": "BR020", "paragraph": "2400-UPDATE-CUSTOMER / 9999-ABEND", "errorCode": "U999", "condition": "SQLCODE < 0 OR FILE STATUS error", "action": "ROLLBACK unit of work and ABEND", "javaImplementation": "@Transactional rollback on RuntimeException -> HTTP 500 / batch record failure", "source": "COBOL" },
    { "ruleId": "BR021", "paragraph": "2500-WRITE-AUDIT", "errorCode": null, "condition": "Update succeeds", "action": "Write audit record (old/new status, old/new limit, version, user, timestamp)", "javaImplementation": "CustomerUpdatedEvent published to Kafka topic customer.updated.v1 after commit", "source": "COBOL" },
    { "ruleId": "BR022", "paragraph": "2000-PROCESS-TXN / 7000-COMMIT", "errorCode": null, "condition": "Batch mode: WS-COMMIT-CNT >= 100", "action": "COMMIT every 100 successful updates; rejected records go to reject file and do not stop the run", "javaImplementation": "CustomerUpdateBatchJob: one transaction per record, rejects logged and counted", "source": "COBOL" }
  ]
}
